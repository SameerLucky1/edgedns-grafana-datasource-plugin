{
  "name": "akamai-edgedns-datasource-plugin",
  "version": "2.1.0",
  "description": "Grafana datasource for Akamai Edge DNS metrics",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": "Steven Vernick",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.2.0",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.3",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "webpack": "^5.108.2",
    "webpack-cli": "^7.1.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "resolutions": {
    "rxjs": "7.8.2",
    "@types/react": "18.0.37",
    "@types/react-dom": "18.0.11",
    "dompurify": ">=3.3.2",
    "immutable": ">=5.1.5",
    "glob": ">=10.5.0",
    "uuid": ">=11.1.1",
    "js-cookie": ">=3.0.7",
    "js-yaml": ">=4.2.0",
    "@opentelemetry/core": ">=2.8.0"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.1.0",
    "@grafana/runtime": "13.1.0",
    "@grafana/schema": "^13.1.0",
    "@grafana/ui": "13.1.0",
    "dompurify": ">=3.3.2",
    "immutable": ">=5.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "packageManager": "yarn@4.17.0"
}
